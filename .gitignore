venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Input data (never commit raw images or training crops) ────────────────────
data/raw/
data/processed/
data/reference/
data/lora_train/
data/lora_dataset/
!data/.gitkeep

# ── Large model weights ───────────────────────────────────────────────────────
*.pt
*.pth
*.bin
*.safetensors
# But DO track the LoRA weights we ship
!outputs/lora_weights/hampi_lora.pt

# ── 3D / mesh files (large) ──────────────────────────────────────────────────
*.ply
*.obj
*.glb
*.gltf
outputs/meshes/
outputs/point_clouds/

# ── Generated visualizations (reproducible, no need to track) ────────────────
outputs/visualizations/
outputs/reports/
outputs/features/
outputs/candidates/

# ── Interactive HTML (too large) ─────────────────────────────────────────────
outputs/**/*.html

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
*.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
